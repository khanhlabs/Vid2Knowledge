project_id       = "your-gcp-project"
environment      = "staging"
backend_image    = "asia-southeast1-docker.pkg.dev/your-gcp-project/vid2knowledge/backend@sha256:replace"
auth_issuer_uri  = "https://your-project.supabase.co/auth/v1"
frontend_origin  = "https://staging.example.com"
# Optional but strongly recommended before enabling paid providers.
billing_account_id = "000000-000000-000000"
monthly_budget_usd  = 25
alert_notification_emails = ["founder@example.com", "operations-backup@example.com"]
payos_enabled    = false
payos_return_url = "https://staging.example.com/app?payment=success"
payos_cancel_url = "https://staging.example.com/app?payment=cancelled"
notifications_enabled = false
notification_from     = "Vid2Knowledge <hello@example.com>"
legal_policies = {
  policy_set_version     = "2026-09-staging"
  terms_version          = "2026-09-staging"
  terms_url              = "https://staging.example.com/legal/terms"
  privacy_version        = "2026-09-staging"
  privacy_url            = "https://staging.example.com/legal/privacy"
  acceptable_use_version = "2026-09-staging"
  acceptable_use_url     = "https://staging.example.com/legal/acceptable-use"
  ai_notice_version      = "2026-09-staging"
  ai_notice_url          = "https://staging.example.com/legal/ai-notice"
  reviewed               = false
}

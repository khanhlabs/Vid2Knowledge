# Local PostgreSQL (matches docker-compose.yaml defaults)
DB_NAME=vid2knowledge
DB_URL=jdbc:postgresql://localhost:5433/vid2knowledge
DB_USERNAME=vid2knowledge
DB_PASSWORD=change-me-for-local-development

# Gemini: create and rotate this value outside Git
GEMINI_API_KEY=replace-with-a-local-development-key
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=180s

# YouTube Data API is required to verify public/embeddable status and duration.
YOUTUBE_API_KEY=replace-with-a-server-side-key
YOUTUBE_MAX_DURATION_SECONDS=14400

# Supabase JWT verification in the production Spring profile.
AUTH_ISSUER_URI=https://your-project.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated

# Async production delivery. Keep INLINE for local development.
TASK_QUEUE_MODE=INLINE
GCP_PROJECT=
GCP_TASKS_LOCATION=asia-southeast1
GCP_ANALYSIS_QUEUE=analysis
WORKER_BASE_URL=
TASK_SERVICE_ACCOUNT_EMAIL=
TASK_OIDC_AUDIENCE=

# payOS is intentionally off until valid merchant credentials are present.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/app?payment=success
PAYOS_CANCEL_URL=http://localhost:5173/app?payment=cancelled

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Per-instance application guardrails; Cloudflare/WAF remains the distributed outer layer.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_MUTATIONS=240
RATE_LIMIT_EXPENSIVE_MUTATIONS=30
RATE_LIMIT_PAYMENT_MUTATIONS=20
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX_KEYS=50000

# Payload minimisation. Financial/audit/learning records follow their separate contractual policy.
RETENTION_GENERATION_PAYLOAD=30d
RETENTION_PAYMENT_WEBHOOK_PAYLOAD=90d
RETENTION_TERMINAL_OUTBOX=30d
RETENTION_TERMINAL_NOTIFICATION=30d
RETENTION_TERMINAL_INVITATION=90d

# Production refuses to boot until counsel-reviewed HTTPS policies are configured.
LEGAL_POLICY_SET_VERSION=2026-09-draft
LEGAL_TERMS_VERSION=2026-09-draft
LEGAL_TERMS_URL=/legal/terms
LEGAL_PRIVACY_VERSION=2026-09-draft
LEGAL_PRIVACY_URL=/legal/privacy
LEGAL_ACCEPTABLE_USE_VERSION=2026-09-draft
LEGAL_ACCEPTABLE_USE_URL=/legal/acceptable-use
LEGAL_AI_NOTICE_VERSION=2026-09-draft
LEGAL_AI_NOTICE_URL=/legal/ai-notice
LEGAL_REVIEWED=false
LEGAL_REQUIRE_PRODUCTION_READINESS=false
